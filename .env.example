# ============================================================================
# Real-Time AI Interview Assistant — Environment Configuration Example
# Copy this file to `.env` in root (or `apps/backend/.env` and `apps/frontend/.env.local`)
# Never commit real API keys to version control.
# ============================================================================

# --- Backend Configuration ---
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# Deepgram Streaming Speech-to-Text API Key
DEEPGRAM_API_KEY=your_deepgram_api_key

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Optional Question Detection Tuning (in milliseconds)
QUESTION_SILENCE_THRESHOLD_MS=900

# --- Frontend Configuration ---
NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:4000
